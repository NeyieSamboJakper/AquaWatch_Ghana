# Copy this file to .env and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API). Never commit .env.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed to run scripts/run_migration.mjs (schema setup) — not required for the app itself.
# These are secrets: keep them out of git and out of any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=

# Optional — overrides the email confirmation redirect URL during local dev
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
